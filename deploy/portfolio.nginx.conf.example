# Template only: replace portfolio.example.com with the chosen domain.
# Inspect the existing server before installation; this is not a default host.
server {
    listen 80;
    server_name portfolio.example.com;
    root /var/www/chimwemwe-portfolio/current;
    index index.html;
    autoindex off;

    access_log /var/log/nginx/chimwemwe-portfolio.access.log;
    error_log /var/log/nginx/chimwemwe-portfolio.error.log;

    # Assets retain stable names, so always revalidate after an update.
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ =404;
    }
    location ~ /\. {
        deny all;
    }
}
